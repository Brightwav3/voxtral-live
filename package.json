{
  "name": "voxtral-live",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Windows voice daemon powered by Mistral audio services",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "tts": "node --env-file=.env src/cli.mjs",
    "transcribe": "node --env-file=.env src/transcribe-cli.mjs",
    "daemon": "node --env-file=.env src/daemon.mjs",
    "control": "node --env-file=.env src/daemon.mjs --control",
    "dev": "node --env-file=.env src/server.mjs",
    "start": "node --env-file=.env src/server.mjs"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "naudiodon2": "2.5.0",
    "ws": "^8.21.0"
  }
}
